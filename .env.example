# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
NEXT_PUBLIC_APP_URL="MY_APP_URL"

# Pesapal v3 Payment Gateway Configuration
PESAPAL_CONSUMER_KEY=""
PESAPAL_CONSUMER_SECRET=""
PESAPAL_ENV="sandbox"

# PostgreSQL / Neon
SQL_HOST="YOUR_SQL_HOST"
SQL_USER="YOUR_SQL_USER"
SQL_PASSWORD="YOUR_SQL_PASSWORD"
SQL_DB_NAME="YOUR_SQL_DATABASE"
SQL_SSL="true"

# Supabase (client-side, browser-exposed - see src/lib/supabase.ts and
# supabase/client_schema.sql). Both come from Supabase Dashboard > Project
# Settings > Data API. The anon key is safe to expose to the browser: RLS
# policies in client_schema.sql are what actually restrict access, not key
# secrecy. Never put the Supabase service_role key in a VITE_ variable -
# that key bypasses RLS entirely and must only ever live on the server.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# ALLOWED_ORIGINS: comma-separated list of origins allowed to make
# cross-origin requests to /api/*. Optional - if unset, APP_URL/
# NEXT_PUBLIC_APP_URL is used as a fallback, and if neither is set, no
# cross-origin requests are allowed (safe default for a same-origin SPA).
# Example: "https://visorstream.com,https://staging.visorstream.com"
ALLOWED_ORIGINS=""

# REDIS_URL: optional. When set, API rate limiting uses a shared Redis
# counter so the limit is enforced correctly across multiple server
# instances. When unset, falls back to a per-instance in-memory counter
# (fine for a single instance, not for horizontal scaling).
REDIS_URL=""

# Mux video delivery
MUX_TOKEN_ID=""
MUX_TOKEN_SECRET=""
MUX_WEBHOOK_SECRET=""

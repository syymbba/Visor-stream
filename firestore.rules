rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // IMPORTANT: `balanceUSD` and `proGamerTier` are intentionally NEVER included
      // in the allow-lists below. Those fields gate real money and paid-tier access
      // and must only ever be written by the trusted backend via the Admin SDK
      // (which bypasses these rules), never directly by an end-user's client.
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'email', 'photoURL', 'bio', 'networkProvider',
          'mobileNumber', 'lowDataMode', 'notificationsEnabled',
          'privacyProfileVisibility', 'privacyDirectMessages', 'blockedUsers',
          'chatFlair', 'showBalanceInHeader',
          'createdAt', 'updatedAt'
        ])
        && (!('blockedUsers' in request.resource.data)
            || (request.resource.data.blockedUsers is list
                && request.resource.data.blockedUsers.size() <= 500));
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'email', 'photoURL', 'bio', 'networkProvider',
          'mobileNumber', 'lowDataMode', 'notificationsEnabled',
          'privacyProfileVisibility', 'privacyDirectMessages', 'blockedUsers',
          'chatFlair', 'showBalanceInHeader',
          'updatedAt'
        ])
        && (!('blockedUsers' in request.resource.data)
            || (request.resource.data.blockedUsers is list
                && request.resource.data.blockedUsers.size() <= 500));
      allow delete: if false;
    }

    match /streams/{streamId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'userId', 'title', 'description', 'game', 'thumbnailUrl',
          'isLive', 'createdAt', 'updatedAt'
        ]);
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'description', 'game', 'thumbnailUrl', 'isLive', 'updatedAt'
        ]);
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    match /chat_messages/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'streamId', 'userId', 'sender', 'message', 'timestamp', 'badge',
          'isDonation', 'donationAmount', 'donationCurrency', 'donationMessage'
        ])
        && request.resource.data.streamId is string
        && request.resource.data.userId is string
        && request.resource.data.sender is string
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 1000;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['message', 'updatedAt'])
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 1000;
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // NOTE: there is intentionally no `tips` collection rule here. The
    // authoritative tip/earnings ledger lives in Postgres (`tips` table),
    // written only by the trusted backend once a Pesapal payment actually
    // completes (see server.ts). A Firestore-side `tips` collection used to
    // be written to independently by dead client code (see chatService.ts),
    // which risked a split-brain ledger where viewer-facing tip totals could
    // disagree with a creator's real payout balance. Do not reintroduce
    // client-writable access to a `tips` collection here.

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
